# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# --- Database (Supabase Postgres) ---
# Use the "Transaction pooler" connection string from Supabase project settings
# (Settings > Database > Connection string > Transaction pooler) so it works
# on serverless/edge hosts like Vercel.
DATABASE_URL="postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres"

# --- Better Auth ---
BETTER_AUTH_URL=http://localhost:3000
# Generate with: pnpm dlx @better-auth/cli secret
BETTER_AUTH_SECRET=

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Price IDs for the demo checkout page (src/routes/integrations/stripe.tsx).
# Server-only (no VITE_ prefix): the client picks a plan by name, the server
# resolves the actual Stripe price ID, so the client can never pass in an
# arbitrary price.
STRIPE_PRICE_ID_MONTHLY=price_xxx
STRIPE_PRICE_ID_YEARLY=price_xxx

# --- Resend ---
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL="Your App <onboarding@yourdomain.com>"

# --- PostHog (analytics) ---
VITE_POSTHOG_KEY=phc_xxx
# Optional: PostHog API host (for self-hosted or EU cloud)
# VITE_POSTHOG_HOST=https://us.i.posthog.com

# --- Sentry (error tracking) ---
VITE_SENTRY_DSN=
VITE_SENTRY_ORG=
VITE_SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
